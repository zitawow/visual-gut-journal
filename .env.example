# Safe for the Expo client. Copy this file to .env.local and replace the values
# with the Project URL and Publishable key from Supabase Project Settings > API.
# Never put a service_role or secret key in an EXPO_PUBLIC_ variable.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Roboflow is called only by the Supabase Edge Function. Do not add its key here.
# Configure the server secret as ROBOFLOW_API_KEY in Supabase instead.
